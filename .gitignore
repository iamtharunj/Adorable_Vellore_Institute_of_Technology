# the synthetic cohort is regenerated by `python -m twin.synth`; three wearable files are kept as a sample
data/synthetic/wearables/*
!data/synthetic/wearables/SYN-00[1-3].csv
# regional cohorts are regenerated by `python -m twin.india`; one wearable file per region is kept as a sample
data/synthetic/india_*/wearables/*
!data/synthetic/india_*/wearables/IN*-001.csv
